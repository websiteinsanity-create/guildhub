# Copy this file to ".env" (same folder) and fill it in. Never share or commit ".env": it contains secrets.
# Step by step guide: README.md, section "Discord setup".

# Where players open the app in their browser. No slash at the end. Use https:// when it is on the internet.
PUBLIC_URL=http://localhost:3000

# Discord Developer Portal > your application > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Developer Portal > your application > Bot > Reset Token. Used to send direct messages (PINs and reminders).
DISCORD_BOT_TOKEN=

# Discord Developer Portal > your application > General Information > Public Key. Lets Guild Hall verify that
# a reminder-button click really came from Discord. Only needed once you set this app's Interactions Endpoint
# URL (same page) to https://<your PUBLIC_URL>/discord/interactions - see README.md "Discord setup".
DISCORD_PUBLIC_KEY=

# Your Discord server: only its members can sign in. (Discord > Settings > Advanced > Developer Mode, then right click the server icon > Copy Server ID)
DISCORD_GUILD_ID=

# Who is an officer: people with one of these roles (comma separated role ids) ...
DISCORD_OFFICER_ROLE_IDS=
# ... and/or these people (comma separated Discord user ids). Put yourself here so you can get in the first time.
DISCORD_OFFICER_USER_IDS=

# Optional: only people who have this role may sign in.
DISCORD_MEMBER_ROLE_ID=

# Optional: which network address to listen on. Leave empty for all (fine at home and in Docker). Use 127.0.0.1 when a reverse proxy (Caddy, nginx) on the same machine sits in front.
LISTEN_HOST=

# Optional: live control panel for a separate, self-hosted Shotcaller bot (voice-session mute/stop/caller
# management). Both have to be set to turn it on - DISCORD_GUILD_ID above is reused, not asked for twice.
# SHOTCALLER_URL points at the bot's own container: with Shotcaller on network_mode: host and Guild Hall on the
# normal Docker bridge network, that's host.docker.internal plus whatever port the bot's health server listens
# on (see the bot's own PORT) - add "extra_hosts: [\"host.docker.internal:host-gateway\"]" to this service in
# docker-compose.yml so that hostname resolves. SHOTCALLER_API_KEY must match the bot's own CONTROL_API_KEY
# exactly (generate one with: openssl rand -hex 32).
SHOTCALLER_URL=
SHOTCALLER_API_KEY=
